  m_Script: {fileID: 11500000, guid: 67e749f2b7d7bc244ac0f5a2749ac2ee, type: 3}
  m_Name: Hammer
  m_EditorClassIdentifier: Assembly-CSharp::LetterData
  contentList:
  - I hope Mrs. Claus and the elves are doing well!  I broke my hammer this year.
    Could you please bring me another one?
  - I hope you're ready for Christmas!  I accidentally broke my hammer this year,
    and I would be very grateful if you could bring me a new one so I can keep building
    things. Thank you!
  - I hope you are having a great day at the North Pole!  I need a sturdy tool to
    help me shape and fix the world again.
