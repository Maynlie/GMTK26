  m_Script: {fileID: 11500000, guid: 67e749f2b7d7bc244ac0f5a2749ac2ee, type: 3}
  m_Name: TalkyWalky
  m_EditorClassIdentifier: Assembly-CSharp::LetterData
  giftId: 13
  contentList:
  - "I hope you are not too busy getting all the presents ready!  I would love some
    walkie-talkies so I can chat with my dad when he\u2019s downstairs watching TV.
    Thank you very much!"
  - "I hope you're doing well.  I\u2019m wishing for two magic boxes that let voices
    travel through the air."
