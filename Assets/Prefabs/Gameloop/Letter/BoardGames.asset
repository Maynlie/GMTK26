  m_Script: {fileID: 11500000, guid: 67e749f2b7d7bc244ac0f5a2749ac2ee, type: 3}
  m_Name: BoardGames
  m_EditorClassIdentifier: Assembly-CSharp::LetterData
  contentList:
  - 'I hope you and your reindeer are doing okay!  I wish to have the latest board
    game released this year! Many thanks. '
  - "I hope you and your reindeer are doing okay!  I would be thrilled to receive
    the newest board game of the year. I can\u2019t wait to play it with my family
    during the holidays. Many thanks! "
  - "I hope you're having fun preparing Christmas!  I\u2019m hoping for a box full
    of rules, pieces, and laughter to share around the table. "
